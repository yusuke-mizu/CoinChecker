// Cloudflare WORKER config for OpenNext — not Pages.
// Do not add pages_build_output_dir. A Pages Git project looking for "dist" will fail.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coinchecker",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    // Prefer Worker for API so Static Assets never serve HTML for /api/*.
    // Remaining paths still use asset-first (OpenNext default / cost-efficient).
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "coinchecker"
    }
  ]
}
